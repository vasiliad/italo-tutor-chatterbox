@@ -0,0 +1,52 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:italo_tutor/core/audio/mic_check.dart';
+
+class FakeMic implements MicProbe {
+  FakeMic({this.permission = true, this.peak = -20, this.error});
+  final bool permission;
+  final double peak;
+  final Object? error;
+  bool listened = false;
+
+  @override
+  Future<bool> hasPermission({bool request = true}) async => permission;
+
+  @override
+  Future<double> peakLevel(Duration duration) async {
+    listened = true;
+    if (error != null) throw error!;
+    return peak;
+  }
+}
+
+void main() {
+  test('голос слышен — ok, уровень в отчёте', () async {
+    var prompted = false;
+    final r = await MicCheck(FakeMic(peak: -18)).run(onListening: () => prompted = true);
+    expect(r.result, MicResult.ok);
+    expect(r.peakDbfs, -18);
+    expect(prompted, isTrue);
+  });
+
+  test('нет доступа — denied, слушать не пытаемся', () async {
+    final mic = FakeMic(permission: false);
+    final r = await MicCheck(mic).run();
+    expect(r.result, MicResult.denied);
+    expect(mic.listened, isFalse);
+  });
+
+  test('тишина ниже порога — silent', () async {
+    final r = await MicCheck(FakeMic(peak: micVoiceThresholdDbfs - 10)).run();
+    expect(r.result, MicResult.silent);
+  });
+
