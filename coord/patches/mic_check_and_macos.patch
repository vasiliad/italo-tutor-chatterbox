new file mode 100644
index 0000000..a5cc3ae
--- /dev/null
+++ b/lib/core/audio/mic_check.dart
@@ -0,0 +1,131 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'package:path/path.dart' as p;
+import 'package:record/record.dart';
+
+/// Итог проверки микрофона при запуске.
+enum MicResult {
+  ok,
+
+  /// Доступ к микрофону не выдан (macOS: Конфиденциальность → Микрофон).
+  denied,
+
+  /// Доступ есть, но голоса не слышно (выключен, не тот вход, слишком тихо).
+  silent,
+
+  /// Микрофона нет или запись не запускается.
+  unavailable,
+}
+
+class MicReport {
+  MicReport(this.result, {this.peakDbfs, this.detail});
+  final MicResult result;
+
+  /// Самый громкий момент за время проверки, dBFS (0 — предел, −160 — тишина).
+  final double? peakDbfs;
+  final String? detail;
+}
+
+/// Порог «голос слышен»: обычная речь в полуметре от встроенного микрофона
+/// даёт −35…−15 dBFS, тишина в комнате — ниже −50.
+const micVoiceThresholdDbfs = -42.0;
+
+/// То, что проверке нужно от микрофона (для тестов — подделка).
+abstract interface class MicProbe {
+  /// Есть ли доступ; при [request] — спросить систему (первый запуск).
+  Future<bool> hasPermission({bool request = true});
+
+  /// Послушать [duration] и вернуть самый громкий уровень, dBFS.
+  Future<double> peakLevel(Duration duration);
+}
+
+/// Проверка: доступ → «скажите Ciao!» → уровень сигнала.
+class MicCheck {
+  MicCheck(this.probe, {this.listenFor = const Duration(seconds: 3)});
+  final MicProbe probe;
+  final Duration listenFor;
+
+  /// [onListening] вызывается, когда пора говорить (показать «Скажите Ciao!»).
+  Future<MicReport> run({void Function()? onListening}) async {
+    try {
+      if (!await probe.hasPermission()) return MicReport(MicResult.denied);
+      onListening?.call();
+      final peak = await probe.peakLevel(listenFor);
+      return MicReport(
+        peak >= micVoiceThresholdDbfs ? MicResult.ok : MicResult.silent,
+        peakDbfs: peak,
+      );
+    } catch (e) {
+      return MicReport(MicResult.unavailable, detail: '$e');
+    }
+  }
+}
+
+/// Настоящий микрофон через пакет record: пишем во временный файл и каждые
+/// 100 мс спрашиваем уровень.
+class RecordMicProbe implements MicProbe {
+  @override
+  Future<bool> hasPermission({bool request = true}) async {
+    final r = AudioRecorder();
+    try {
+      return await r.hasPermission(request: request);
+    } finally {
+      await r.dispose();
+    }
+  }
+
+  @override
+  Future<double> peakLevel(Duration duration) async {
+    final r = AudioRecorder();
+    final path = p.join(Directory.systemTemp.path,
+        'italo_mic_check_${DateTime.now().millisecondsSinceEpoch}.wav');
+    var peak = -160.0;
+    try {
+      await r.start(const RecordConfig(encoder: AudioEncoder.wav), path: path);
+      final end = DateTime.now().add(duration);
+      while (DateTime.now().isBefore(end)) {
+        await Future<void>.delayed(const Duration(milliseconds: 100));
+        final a = await r.getAmplitude();
+        if (a.current.isFinite && a.current > peak) peak = a.current;
+      }
+      await r.stop();
+    } finally {
+      await r.dispose();
+      final f = File(path);
+      if (await f.exists()) await f.delete();
+    }
+    return peak;
+  }
+}
+
+/// Открыть системные настройки доступа к микрофону (где это возможно).
+Future<bool> openMicPrivacySettings() async {
+  try {
+    if (Platform.isMacOS) {
+      final r = await Process.run('open', [
+        'x-apple.systempreferences:com.apple.preference.security?Privacy_Microphone'
+      ]);
+      return r.exitCode == 0;
+    }
+    if (Platform.isWindows) {
+      final r = await Process.run('cmd', ['/c', 'start', 'ms-settings:privacy-microphone']);
+      return r.exitCode == 0;
+    }
+  } catch (_) {}
+  return false;
+}
+
+/// Подсказка, как выдать доступ, — по-русски, для ученицы.
+String micPermissionHelp() {
+  if (Platform.isMacOS) {
+    return 'Откройте «Системные настройки» → «Конфиденциальность и безопасность» → '
+        '«Микрофон» и включите italo_tutor. Потом нажмите «Проверить снова».';
+  }
+  if (Platform.isWindows) {
+    return 'Откройте «Параметры» → «Конфиденциальность» → «Микрофон» и разрешите '
+        'доступ приложениям. Потом нажмите «Проверить снова».';
+  }
+  return 'Разрешите программе доступ к микрофону в настройках системы и '
+      'проверьте, что микрофон подключён и не выключен.';
+}
